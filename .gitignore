# =============================================================================
# .gitignore  –  LLM Gateway
# =============================================================================

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
MANIFEST

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env.bak

# ── CRITICAL: Environment / secrets ──────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
credentials/

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
nosetests.xml
test-results/
junit.xml

# ── Type checking ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# ── Documentation ─────────────────────────────────────────────────────────────
docs/_build/
site/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Docker ────────────────────────────────────────────────────────────────────
.docker/

# ── ML model cache (sentence-transformers downloads) ─────────────────────────
.cache/
models/
sentence_transformers_cache/
transformers_cache/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
ehthumbs.db
desktop.ini

# ── Misc ─────────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
.hypothesis/
